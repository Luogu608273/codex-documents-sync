{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OI: debug",
      "type": "process",
      "command": "C:/TDM-GCC-64/bin/g++.exe",
      "args": ["-std=c++17", "-Og", "-g", "-Wall", "-Wextra", "-D_GLIBCXX_ASSERTIONS", "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}.exe"],
      "options": {"cwd": "${fileDirname}"},
      "problemMatcher": ["$gcc"],
      "group": {"kind": "build", "isDefault": true}
    },
    {
      "label": "OI: release",
      "type": "process",
      "command": "C:/TDM-GCC-64/bin/g++.exe",
      "args": ["-std=c++17", "-O2", "-Wall", "-Wextra", "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}.exe"],
      "options": {"cwd": "${fileDirname}"},
      "problemMatcher": ["$gcc"],
      "group": "build"
    }
  ]
}
